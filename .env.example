# Copy to .env and adjust. NEVER commit the real .env.

# --- Django backend ---
DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "sqlite" for quick local runs, "postgres" to use docker-compose db
DATABASE_ENGINE=sqlite
POSTGRES_DB=rutex
POSTGRES_USER=rutex
POSTGRES_PASSWORD=rutex_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS: frontend dev origin
FRONTEND_ORIGIN=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
